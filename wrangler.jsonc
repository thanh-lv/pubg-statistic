{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pubg-squad-stats",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    // Các file build của React được phục vụ như static assets.
    // Mọi route không phải /api/* sẽ trả về index.html (SPA).
    // "directory" giúp các lệnh wrangler (secret put, deploy…) chạy được cả khi chưa build.
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Giữ lại các biến đặt trên Dashboard khi deploy (mặc định wrangler sẽ ghi đè bằng "vars" bên dưới).
  // PUBG_API_KEY vẫn nên đặt dạng Secret: `npx wrangler secret put PUBG_API_KEY`.
  "keep_vars": true,
  "vars": {
    // Nền tảng mặc định: steam | kakao | psn | xbox | console
    "DEFAULT_SHARD": "steam"
  }
  // (Khuyến nghị) Bật KV để cache bền hơn và tránh dính rate-limit 10 req/phút:
  //   npx wrangler kv namespace create PUBG_CACHE
  // rồi bỏ comment và dán id vào đây:
  // "kv_namespaces": [{ "binding": "PUBG_CACHE", "id": "<KV_ID>" }]
}
